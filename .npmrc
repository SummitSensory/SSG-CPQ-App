# Prisma's generated client has to sit where TypeScript looks for it. Left in the
# pnpm virtual store, every model and enum resolves to {} and the build prints
# hundreds of "has no exported member" errors that mean nothing.
public-hoist-pattern[]=*prisma*
# Same reason, for the types behind Node's global fetch (Response, Headers).
public-hoist-pattern[]=*undici*
