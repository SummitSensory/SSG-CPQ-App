# Copy to .env and fill in. NEVER commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Postgres (matches docker-compose.yml defaults for local dev)
DATABASE_URL=postgresql://app:app@localhost:5432/app?schema=public

# Auth — generate strong random values, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# monday.com integration (leave blank to disable outside production)
MONDAY_API_TOKEN=
MONDAY_SIGNING_SECRET=
MONDAY_DEALS_BOARD_ID=

# QuickBooks Online — credentials come from HERE only, never source.
# Get client id/secret from the Intuit developer portal. Set all four (or none).
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=https://app.example.com/integrations/quickbooks/callback
# 'sandbox' or 'production'. Start with sandbox.
QBO_ENVIRONMENT=sandbox
# 32+ char secret used to encrypt stored OAuth tokens, e.g. `openssl rand -hex 32`
QBO_TOKEN_ENC_KEY=
# HARD SAFETY GATE — live writes to the PRODUCTION company are refused unless
# this is 'true'. Keep 'false' until the production test plan is authorized.
QBO_PRODUCTION_WRITE_ENABLED=false

# DocuSeal e-signature. Leave blank to disable outside production. See
# docs/docuseal.md — the webhook itself must also be registered by hand in
# DocuSeal's own dashboard, pointed at https://<host>/webhooks/docuseal.
DOCUSEAL_API_TOKEN=
DOCUSEAL_WEBHOOK_SECRET=

# Vercel Blob: where the composed proposal package and the executed/signed PDF
# are kept, so the signed contract does not live only inside DocuSeal (whose
# own document URLs expire in ~40 minutes). Unset is supported but degrades:
# the "Download signed PDF" UI and the monday.com signed-copy push both depend
# on this being set correctly in production.
BLOB_READ_WRITE_TOKEN=

# Resend — used for internal staff alerts (src/lib/alerts.ts): unhandled server
# faults, "customer signed, your countersignature is needed", "proposal viewed",
# and the daily "still not signed" reminder.
RESEND_API_KEY=
# Where those alerts go. Comma-separated for several. Falls back to
# BOM_BCC_EMAIL; with neither set, alerts are logged only.
ALERT_EMAIL=
BOM_BCC_EMAIL=
# Sender identity for the alerts above. Deliberately separate from
# BOM_FROM_EMAIL/BOM_FROM_NAME below — those carry the "Summit Sensory Gym"
# vendor/customer-facing identity, this is the internal "the app noticed
# something" sender. Must be on a domain verified in Resend.
ALERT_FROM_EMAIL=notifications@crm.summitsensory.com
ALERT_FROM_NAME=Summit Sensory CRM
# Escalation recipient for the esign "viewed"/"still not signed" alerts once
# the sending rep's own first-24-hours window has passed.
ESIGN_ESCALATION_EMAIL=sales@summitsensory.com

# Bearer secret Vercel Cron sends on its scheduled requests — required for any
# /cron/* route to run.
CRON_SECRET=
