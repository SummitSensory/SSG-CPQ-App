{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    // "undici-types" is what gives Node's global fetch its real shapes. Without it
    // TypeScript resolves `Response` and `Headers` to `{}` — the source of every
    // "Property 'ok' does not exist on type 'Response'" in the Vercel log. It ships
    // inside @types/node; naming it here stops it being dropped when the installer
    // hides transitive types.
    "types": ["node", "undici-types"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src", "api", "tests", "e2e", "*.config.ts"]
}
