generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SYSTEM_ADMIN
  EXECUTIVE
  SALES_REP
  SALES_MANAGER
  DESIGNER
  ESTIMATOR
  OPERATIONS
  ACCOUNTING
  PROJECT_MANAGER
  INSTALLER
  READ_ONLY
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  title        String?
  phone        String?
  passwordHash String
  role         Role      @default(READ_ONLY)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  passwordResets PasswordResetToken[]
}

/// Self-service password reset. Only the SHA-256 hash of the emailed token is
/// stored, so a database leak cannot be used to take over an account. Single-use
/// (usedAt) and short-lived (expiresAt).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  requestIp String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String
  action       String
  targetUserId String?
  entity       String?
  entityId     String?
  details      Json?
  createdAt    DateTime @default(now())

  @@index([targetUserId])
  @@index([action])
  @@index([entity, entityId])
}

// ---------------- CRM ----------------

enum CustomerType {
  HEALTHCARE_SYSTEM
  HOSPITAL
  PRIVATE_PRACTICE
  SCHOOL
  UNIVERSITY
  GOVERNMENT
  NONPROFIT
  OTHER
}

enum OpportunityStage {
  PROSPECT
  QUALIFICATION
  NEEDS_ANALYSIS
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum FundingStatus {
  UNFUNDED
  BUDGETED
  GRANT_PENDING
  GRANT_AWARDED
  APPROVED
  SELF_FUNDED
}

enum TherapyDiscipline {
  PHYSICAL
  OCCUPATIONAL
  SPEECH
  ABA
  SENSORY_INTEGRATION
  RECREATIONAL
  AQUATIC
  PSYCHOLOGICAL
}

enum PatientPopulation {
  PEDIATRIC
  ADOLESCENT
  ADULT
  GERIATRIC
  SPECIAL_NEEDS
  VETERANS
}

enum AddressType {
  BILLING
  SHIPPING
}

enum FloorType {
  CARPET
  VINYL
  TILE
  CONCRETE
  HARDWOOD
  RUBBER
  OTHER
}

enum WallConstruction {
  DRYWALL
  CONCRETE_BLOCK
  BRICK
  PLASTER
  GLASS
  MODULAR
  OTHER
}

enum AttachmentCategory {
  PHOTOGRAPH
  FLOOR_PLAN
  MEASUREMENT_DOC
  OTHER
}

model Organization {
  id             String         @id @default(cuid())
  name           String
  normalizedName String
  customerType   CustomerType   @default(OTHER)
  taxExempt      Boolean        @default(false)
  taxExemptId    String?
  notes          String?
  /// Default QuickBooks payment term for this client (Settings → All lists →
  /// Terms). A proposal may override it; neither is required.
  qboSalesTermId   String?
  /// Human label, cached so the portal can show the term without calling QuickBooks.
  qboSalesTermName String?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  contacts       Contact[]
  addresses      Address[]
  facilities     Facility[]
  opportunities  Opportunity[]
  attachments    Attachment[]

  @@unique([normalizedName])
  @@index([customerType])
}

model Contact {
  id               String        @id @default(cuid())
  organizationId   String
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  firstName        String
  lastName         String
  email            String?
  phone            String?
  title            String?
  isDecisionMaker  Boolean       @default(false)
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  stakeholderOf    OpportunityStakeholder[]

  @@index([organizationId])
  @@index([email])
}

model Address {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           AddressType
  line1          String
  line2          String?
  city           String
  region         String
  postalCode     String
  country        String       @default("US")

  @@index([organizationId])
}

model Facility {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  notes          String?
  rooms          Room[]

  @@index([organizationId])
}

model Room {
  id                       String            @id @default(cuid())
  facilityId               String
  facility                 Facility          @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  name                     String
  // All dimensions in whole inches (integers) — never floats.
  lengthIn                 Int?
  widthIn                  Int?
  ceilingHeightIn          Int?
  doorWidthIn              Int?
  doorHeightIn             Int?
  floorType                FloorType?
  wallConstruction         WallConstruction?
  hasLoadingDock           Boolean           @default(false)
  liftgateRequired         Boolean           @default(false)
  deliveryRestrictions     String?
  installationRestrictions String?
  notes                    String?

  @@index([facilityId])
}

model Opportunity {
  id                 String              @id @default(cuid())
  organizationId     String
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String
  stage              OpportunityStage    @default(PROSPECT)
  fundingStatus      FundingStatus       @default(UNFUNDED)
  therapyDisciplines TherapyDiscipline[]
  patientPopulations PatientPopulation[]
  // Budget as integer minor units + currency — never floating point.
  budgetAmountMinor  BigInt?
  budgetCurrency     String?
  desiredTimeline    String?
  notes              String?
  // monday.com two-way sync state
  mondayItemId       String?             @unique
  mondaySyncHash     String?
  mondaySyncedAt     DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  stakeholders       OpportunityStakeholder[]
  attachments        Attachment[]

  @@index([organizationId])
  @@index([stage])
  @@index([fundingStatus])
}

// Decision-makers / stakeholders linked to an opportunity.
model OpportunityStakeholder {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  contactId     String
  contact       Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  role          String?
  isPrimary     Boolean     @default(false)

  @@unique([opportunityId, contactId])
  @@index([opportunityId])
}

model Attachment {
  id             String             @id @default(cuid())
  organizationId String?
  organization   Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  opportunityId  String?
  opportunity    Opportunity?       @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  category       AttachmentCategory @default(OTHER)
  fileName       String
  contentType    String
  sizeBytes      Int
  storageKey     String             @unique
  uploadedById   String
  createdAt      DateTime           @default(now())

  @@index([opportunityId])
  @@index([organizationId])
}

enum SyncDirection {
  OUTBOUND
  INBOUND
}

// Append-only log of integration sync events (idempotency + audit).
model IntegrationSyncLog {
  id            String        @id @default(cuid())
  provider      String        @default("monday")
  direction     SyncDirection
  entity        String
  entityId      String?
  externalId    String?
  eventId       String?       @unique
  status        String
  error         String?
  createdAt     DateTime      @default(now())

  @@index([entity, entityId])
}

// ---------------- Product Catalog ----------------
// NOTE: catalog data is DB-managed via the admin API — no price fields here
// (pricing is a separate future milestone) and no deployment needed to edit it.

enum ProductKind {
  PRODUCT
  VARIANT
  COMPONENT
  BUNDLE
  ACCESSORY
  SERVICE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum RelationType {
  VARIANT_OF
  COMPONENT_OF
  BUNDLE_ITEM
  ACCESSORY_OF
}

// A top-level product line (e.g. "Adventure Series"). Categories hang off a
// line and double as its 4-tier structure: header rows and product rows.
model ProductLine {
  id          String            @id @default(cuid())
  name        String            @unique
  slug        String            @unique
  description String?
  sortOrder   Int               @default(0)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  categories  ProductCategory[]
  products    Product[]
}

model ProductCategory {
  id        String            @id @default(cuid())
  name      String
  slug      String            @unique
  parentId  String?
  parent    ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  ProductCategory[] @relation("CategoryTree")
  sortOrder Int               @default(0)
  isActive  Boolean           @default(true)
  families  ProductFamily[]
  products  Product[]

  // Tier-tree fields: a category node is a HEADER when productId is null, or
  // a PRODUCT line when it points at one. Tier 1 is always a header.
  productLineId   String?
  productLine     ProductLine? @relation(fields: [productLineId], references: [id], onDelete: Cascade)
  tierLevel       Int          @default(1)
  defaultQuantity Int?
  productId       String?
  product         Product?     @relation("CategoryTierProduct", fields: [productId], references: [id], onDelete: SetNull)

  @@index([productLineId, tierLevel])
  @@index([parentId, sortOrder])
}

model ProductFamily {
  id          String          @id @default(cuid())
  categoryId  String
  category    ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  products    Product[]

  @@unique([categoryId, slug])
  @@index([categoryId])
}

model Product {
  id                  String              @id @default(cuid())
  sku                 String              @unique
  name                String
  kind                ProductKind         @default(PRODUCT)
  status              ProductStatus       @default(DRAFT)
  version             Int                 @default(1)

  categoryId          String
  category            ProductCategory     @relation(fields: [categoryId], references: [id])
  familyId            String?
  family              ProductFamily?      @relation(fields: [familyId], references: [id], onDelete: SetNull)

  productLineId       String?
  productLine         ProductLine?        @relation(fields: [productLineId], references: [id], onDelete: SetNull)
  defaultQuantity     Int                 @default(1)
  badge               String?
  // Manual order of the default product list (product picker + tier listings).
  sortOrder           Int                 @default(0)

  proposalDescription String?
  internalDescription String?

  // Legacy whole-inch dimensions, superseded by the decimal columns below.
  // Kept (not dropped) so no historical data is lost.
  lengthInLegacy      Int?
  widthInLegacy       Int?
  heightInLegacy      Int?

  // Dimensions in inches (fractional, e.g. 4.875), weight in whole ounces.
  lengthIn            Decimal?            @db.Decimal(8, 3)
  widthIn             Decimal?            @db.Decimal(8, 3)
  heightIn            Decimal?            @db.Decimal(8, 3)
  thicknessIn         Decimal?            @db.Decimal(8, 3)
  // Verbatim override for shapes the L/W/H/T formula can't express (e.g.
  // five-value U-profile mats). When set, this is printed as-is.
  dimensionsOverride  String?
  showDimensions      Boolean             @default(false)

  weightOz            Int?
  capacity            String?

  activeFrom          DateTime?
  activeTo            DateTime?
  adminNotes          String?

  createdById         String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  images              ProductImage[]
  documents           TechnicalDocument[]
  versions            ProductVersion[]
  statusHistory       ProductStatusHistory[]
  parentRelations     ProductRelation[]   @relation("RelationParent")
  childRelations      ProductRelation[]   @relation("RelationChild")
  notes               ProductNote[]
  sourcing            ProductSourcing[]
  tierNodes           ProductCategory[]   @relation("CategoryTierProduct")

  @@index([categoryId])
  @@index([familyId])
  @@index([status])
  @@index([kind])
  @@index([productLineId])
  @@index([sortOrder])
}

// The asterisked lines that print beneath a product on the proposal, e.g.
// "*OPTIONAL ADD-ON: Enhances Versatility".
model ProductNote {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  text      String
  sortOrder Int     @default(0)

  @@index([productId])
}

// ---------------- Manufacturing & Sourcing ----------------
// Who actually fabricates or supplies a part. The BOM groups by manufacturer,
// which cuts across the proposal-facing tier tree — a mat section can contain
// parts from Resilite and GreatMats, and the shop needs them grouped by vendor.
// Cost stays in ProductCost as an effective-dated series; nothing here
// duplicates it.

model Manufacturer {
  id                  String            @id @default(cuid())
  name                String            @unique
  slug                String            @unique
  isThirdParty        Boolean           @default(true)
  /// Every part sourced from this vendor carries the "freight to be determined"
  /// note on its proposal line until a freight figure is entered on that line.
  /// Southpaw and the other freight-quoted vendors are the reason this exists.
  freightTbd          Boolean           @default(false)
  defaultLeadTimeDays Int?
  contactName         String?
  contactEmail        String?
  notes               String?
  isActive            Boolean           @default(true)

  // Vendor of record: where a purchase order is sent and who is called about it.
  // The BOM prints this block as "Ship from".
  contactTitle        String?
  contactPhone        String?
  altContactName      String?
  altContactEmail     String?
  altContactPhone     String?
  addressLine1        String?
  addressLine2        String?
  city                String?
  region              String?
  postalCode          String?
  country             String?           @default("USA")
  website             String?
  accountNumber       String?
  paymentTerms        String?
  // Steel fabricators are the vendors whose lines roll into the BOM's
  // "Total steel weight" — hardware and crating are excluded by definition.
  isSteelFabricator   Boolean           @default(false)

  // ---- Bill of Materials email defaults ----
  // Each vendor is emailed differently: a fabricator gets the shop address and a
  // "please confirm receipt" note, a distributor gets a purchasing inbox. These
  // pre-fill the send dialog; the sender can still edit before sending.
  /// Where the BOM goes by default. Comma-separated for more than one recipient.
  bomEmailTo          String?
  bomEmailCc          String?
  /// Supports the tokens {{vendor}}, {{order}}, {{job}}, {{submittedOn}}.
  bomEmailSubject     String?
  bomEmailBody        String?
  /// Which attachment this vendor expects: EXCEL, PDF or BOTH.
  bomEmailFormat      BomSendFormat     @default(PDF)
  /// Whether a new BOM section for this vendor shows the powder-colour column.
  bomShowPowderColor  Boolean           @default(false)

  // ---- Freight RFQ ----
  /// Whether this vendor quotes freight for us. Off by default: an RFQ sent to a
  /// vendor who does not handle freight is noise in their inbox, so only flagged
  /// vendors appear as RFQ targets on a proposal.
  rfqEnabled          Boolean           @default(false)
  /// The freight desk, which is rarely the same person as the purchasing contact
  /// the BOM goes to. Blank falls back to the primary contact above.
  rfqContactName      String?
  rfqContactEmail     String?
  rfqContactPhone     String?
  /// Send-dialog defaults, same pattern as the BOM's. Tokens: {{vendor}},
  /// {{reference}}, {{customer}}, {{projectId}}, {{total}}.
  rfqEmailTo          String?
  rfqEmailCc          String?
  rfqEmailSubject     String?
  rfqEmailBody        String?

  freightRfqs         FreightRfq[]

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  sourcing            ProductSourcing[]
}

model ProductSourcing {
  id             String       @id @default(cuid())
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  manufacturerId String
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  vendorPartNo   String?
  // Overrides Manufacturer.defaultLeadTimeDays for this part only.
  leadTimeDays   Int?
  minOrderQty    Int?
  isPrimary      Boolean      @default(true)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([productId, manufacturerId])
  @@index([manufacturerId])
}

model ProductRelation {
  id        String       @id @default(cuid())
  parentId  String
  parent    Product      @relation("RelationParent", fields: [parentId], references: [id], onDelete: Cascade)
  childId   String
  child     Product      @relation("RelationChild", fields: [childId], references: [id], onDelete: Restrict)
  type      RelationType
  quantity  Int          @default(1)
  sortOrder Int          @default(0)

  @@unique([parentId, childId, type])
  @@index([childId])
}

model ProductImage {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  storageKey  String   @unique
  fileName    String
  contentType String
  sizeBytes   Int
  sortOrder   Int      @default(0)
  isPrimary   Boolean  @default(false)

  @@index([productId])
}

model TechnicalDocument {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  storageKey  String   @unique
  fileName    String
  contentType String
  sizeBytes   Int
  title       String?

  @@index([productId])
}

// Full snapshot of a product at each revision (version history).
model ProductVersion {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  version     Int
  snapshot    Json
  changeNote  String?
  changedById String
  createdAt   DateTime @default(now())

  @@unique([productId, version])
  @@index([productId])
}

model ProductStatusHistory {
  id          String        @id @default(cuid())
  productId   String
  product     Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  fromStatus  ProductStatus?
  toStatus    ProductStatus
  reason      String?
  changedById String
  createdAt   DateTime      @default(now())

  @@index([productId])
}

// ---------------- Configuration Rules Engine ----------------
// Rules are structured, versioned, auditable DATA — never hard-coded in the UI.

enum RuleType {
  REQUIRES
  EXCLUDES
  COMPATIBLE_WITH
  INCOMPATIBLE_WITH
  MIN_QUANTITY
  MAX_QUANTITY
  MIN_ROOM_DIMENSIONS
  MIN_CEILING_HEIGHT
  CLEARANCE
  STRUCTURAL
  INSTALLATION
  FREIGHT
  AUTO_INCLUDE_COMPONENT
  AUTO_CALCULATED_COMPONENT
  SUGGESTED_ACCESSORY
  SUGGESTED_UPGRADE
  APPROVAL_REQUIRED
  MISSING_INFORMATION
}

enum RuleOutcome {
  ALLOW
  BLOCK
  WARN
  REQUIRE_APPROVAL
  AUTO_ADD
  RECOMMEND
  REQUEST_INFORMATION
}

enum RuleStatus {
  DRAFT
  ACTIVE
  RETIRED
}

model Rule {
  id             String        @id @default(cuid())
  key            String        @unique
  type           RuleType
  outcome        RuleOutcome
  status         RuleStatus    @default(DRAFT)
  currentVersion Int           @default(1)
  description    String?
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  versions       RuleVersion[]

  @@index([status])
  @@index([type])
}

// Immutable snapshot of a rule at each revision.
model RuleVersion {
  id           String   @id @default(cuid())
  ruleId       String
  rule         Rule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  version      Int
  definition   Json
  changeNote   String?
  changedById  String
  approvedById String?
  createdAt    DateTime @default(now())

  @@unique([ruleId, version])
  @@index([ruleId])
}

// Immutable record of an evaluation — preserves the exact ruleset a proposal used.
model RuleEvaluationSnapshot {
  id            String   @id @default(cuid())
  subjectRef    String?
  engineVersion String
  rulesUsed     Json
  findings      Json
  blocked       Boolean  @default(false)
  createdById   String
  createdAt     DateTime @default(now())

  @@index([subjectRef])
}

// ---------------- Pricing Engine ----------------
// All money stored as integer minor units (BigInt) — decimal-safe, never floats.

enum PriceListStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model PriceList {
  id             String           @id @default(cuid())
  name           String
  currency       String
  status         PriceListStatus  @default(DRAFT)
  effectiveDate  DateTime
  expirationDate DateTime?
  createdById    String
  createdAt      DateTime         @default(now())
  entries        PriceListEntry[]

  @@index([status])
  @@index([effectiveDate])
}

model PriceListEntry {
  id           String    @id @default(cuid())
  priceListId  String
  priceList    PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  productId    String
  minQuantity  Int       @default(1)
  unitPrice    BigInt
  createdAt    DateTime  @default(now())

  @@unique([priceListId, productId, minQuantity])
  @@index([productId])
}

model CustomerPrice {
  id             String    @id @default(cuid())
  organizationId String
  productId      String
  unitPrice      BigInt
  currency       String
  effectiveDate  DateTime
  expirationDate DateTime?

  @@index([organizationId, productId])
}

model PromotionalPrice {
  id             String    @id @default(cuid())
  productId      String
  unitPrice      BigInt
  currency       String
  code           String?
  effectiveDate  DateTime
  expirationDate DateTime?

  @@index([productId])
}

model ProductCost {
  id            String   @id @default(cuid())
  productId     String
  unitCost      BigInt
  currency      String
  effectiveDate DateTime
  createdById   String
  createdAt     DateTime @default(now())

  @@index([productId, effectiveDate])
}

// Immutable snapshot of a computed price for a proposal (preserve historical pricing).
model PriceSnapshot {
  id             String   @id @default(cuid())
  subjectRef     String?
  currency       String
  engineVersion  String
  ruleSnapshotId String?
  input          Json
  breakdown      Json
  grandTotal     BigInt
  incomplete     Boolean  @default(false)
  createdById    String
  createdAt      DateTime @default(now())

  @@index([subjectRef])
}

// Every manual override — logged with who, why, and before/after.
model PriceOverrideLog {
  id            String   @id @default(cuid())
  subjectRef    String?
  field         String
  previousValue String?
  newValue      String
  reason        String
  authorizedById String
  createdAt     DateTime @default(now())

  @@index([subjectRef])
}

// ---------------- Proposal Builder ----------------

enum ProposalStatus {
  DRAFT
  INTERNAL_REVIEW
  RELEASED
  ACCEPTED
  REJECTED
  EXPIRED
}

model Proposal {
  id             String            @id @default(cuid())
  number         String            @unique
  organizationId String
  title          String
  currentVersion Int               @default(1)
  createdById    String
  /// Per-deal QuickBooks payment term. Overrides the organization default when
  /// set; null means fall back to the client default, then the system default.
  qboSalesTermId   String?
  qboSalesTermName String?

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  versions       ProposalVersion[]
  freightRfqs    FreightRfq[]

  @@index([organizationId])
}

// A version is the unit of immutability: once RELEASED it is frozen.
model ProposalVersion {
  id              String                @id @default(cuid())
  proposalId      String
  proposal        Proposal              @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  version         Int
  status          ProposalStatus        @default(DRAFT)
  sections        Json
  items           Json
  priceSnapshotId String?
  ruleSnapshotId  String?
  expirationDate  DateTime?
  releasedAt      DateTime?
  releasedById    String?
  frozen          Boolean               @default(false)
  createdById     String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  statusHistory   ProposalStatusEvent[]

  @@unique([proposalId, version])
  @@index([proposalId])
  @@index([status])
}

model ProposalStatusEvent {
  id          String          @id @default(cuid())
  versionId   String
  version     ProposalVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  fromStatus  ProposalStatus?
  toStatus    ProposalStatus
  note        String?
  changedById String
  createdAt   DateTime        @default(now())

  @@index([versionId])
}

// A reusable proposal starting point: default groups, note lines, standard
// descriptions and ordering, saved as a JSON document the builder loads.
model ProposalTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  data        Json
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

// Where a standard note prints: inside the line-item table, or beneath the
// signature lines at the foot of the proposal.
enum NotePlacement {
  TABLE
  FOOTER
}

// Reusable boilerplate note blocks. autoInclude notes are added to every new
// proposal automatically; the rest stay available in the builder's note picker.
model StandardNote {
  id          String        @id @default(cuid())
  title       String
  body        String
  placement   NotePlacement @default(TABLE)
  autoInclude Boolean       @default(false)
  sortOrder   Int           @default(0)
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([active, placement, sortOrder])
}

// Editable coefficients behind the H-1000 fastener quantities. The formula shape
// lives in src/proposals/hardwareRules.ts; these rows override its numbers so a
// multiplier can be corrected in the app instead of in a deploy. Absent rows fall
// back to the workbook defaults.
model HardwareRule {
  id          String   @id @default(cuid())
  kind        String   @default("HARDWARE")
  part        String
  name        String
  terms       Json
  constant    Float    @default(0)
  factor      Float    @default(1)
  roundMode   String   @default("NONE")
  roundStep   Float    @default(1)
  mode        String   @default("SUM")
  minZero     Boolean  @default(true)
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  when        Json?
  group       String?
  note        String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([kind, part])
  @@index([sortOrder])
}

// Business scalars behind the proposal math (deposit %, proposal validity, leg
// spans). Defaults live in src/proposals/formulaSettings.ts; a row here overrides
// one of them.
model FormulaSetting {
  key         String   @id
  value       Float
  updatedById String?
  updatedAt   DateTime @updatedAt
}

// Pricing/SKU master — the single editable source the Adventure engine and the
// builder product picker both read from. Fed by seed, Excel/CSV import, the
// in-app editor, and (later) live cloud sync.
model Sku {
  id             String   @id @default(cuid())
  part           String   @unique
  description    String
  unitPriceMinor Int      @default(0)
  unitCostMinor  Int      @default(0)
  weightLbs      Float    @default(0)
  category       String   @default("OTHER")
  manufacturer   String?
  proposalGroup  String?
  active         Boolean  @default(true)
  /// Pre-approved for part-number substitution in the proposal builder. Only
  /// flagged parts can be swapped by a rep; everything else is fixed.
  overrideAllowed Boolean @default(false)
  /// Default quantity the proposal builder seeds this part with. NULL = no
  /// default (starts at 0); 0 = an explicit "none". A rep's entry always wins.
  defaultQty     Int?
  /// Fixed freight charge applied to this part's line automatically when it is
  /// added to a proposal. NULL = no default; 0 = an explicit "no freight". Prints
  /// as the line's 3rd-party freight row. A rep's entry always wins.
  freightMinor   Int?
  /// Wording for that freight row, e.g. "Passthrough freight — LTL". Defaults to
  /// "Freight" when blank.
  freightLabel   String?
  /// Where this part is bought. Shown as a "Buy" link on the Bill of Materials so
  /// a purchaser can go straight to the vendor's order page. Manually editable and
  /// accepted as a `productUrl` column by the CSV importer.
  productUrl     String?
  /// Whether this part must carry a powder-coat colour before its BOM section can
  /// be submitted. Off by default — most parts are not powder coated at all, and
  /// requiring a colour on them was blocking submission.
  requiresPowderColor Boolean @default(false)
  /// Packaging bag this part is shipped in, e.g. "Bag 7". Set on about thirty
  /// hardware items so the shop can tell which bag to open. NULL = not bagged.
  packagingBag   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category])
  @@index([active])
}

// ---------------- Internal Approval Workflow ----------------

enum ApprovalType {
  DISCOUNT
  MARGIN_EXCEPTION
  CUSTOM_PRICING
  CUSTOM_PRODUCT
  PRODUCT_RULE_OVERRIDE
  FREIGHT_EXCEPTION
  INSTALLATION_EXCEPTION
  LEGAL_EXCEPTION
  PAYMENT_TERM_EXCEPTION
  PROPOSAL_RELEASE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  REVISION_REQUESTED
  ESCALATED
  EXPIRED
  CANCELLED
}

model ApprovalRequest {
  id              String          @id @default(cuid())
  type            ApprovalType
  status          ApprovalStatus  @default(PENDING)
  subjectRef      String?
  proposalId      String?
  proposalVersion Int?
  requesterId     String
  approverId      String?
  reason          String
  supportingInfo  Json?
  originalValue   String?
  requestedValue  String
  decision        ApprovalStatus?
  decisionNotes   String?
  decidedAt       DateTime?
  escalatedToId   String?
  expiresAt       DateTime
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  events          ApprovalEvent[]

  @@index([status])
  @@index([type])
  @@index([requesterId])
  @@index([approverId])
  @@index([proposalId, proposalVersion])
}

model ApprovalEvent {
  id        String          @id @default(cuid())
  requestId String
  request   ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  action    String
  actorId   String
  notes     String?
  createdAt DateTime        @default(now())

  @@index([requestId])
}

model ApprovalDelegation {
  id          String        @id @default(cuid())
  fromUserId  String
  toUserId    String
  type        ApprovalType?
  startsAt    DateTime      @default(now())
  endsAt      DateTime?
  createdById String
  createdAt   DateTime      @default(now())

  @@index([toUserId])
  @@index([fromUserId])
}

// ---------------- monday.com External Links ----------------

enum SyncState {
  LINKED
  PENDING
  ERROR
  CONFLICT
}

model ExternalLink {
  id             String    @id @default(cuid())
  provider       String    @default("monday")
  entity         String
  entityId       String
  externalId     String
  boardId        String?
  lastSyncedHash String?
  lastSyncedAt   DateTime?
  state          SyncState @default(LINKED)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([provider, entity, entityId])
  @@unique([provider, externalId])
  @@index([entity, entityId])
}

// ---------------- QuickBooks Online Integration ----------------
// Financial integration. Every live transaction is authorized by a user,
// deduplicated by an idempotency key, and preserves the accepted proposal
// totals verbatim. Credentials NEVER live in source — OAuth tokens are stored
// encrypted here; client id/secret come from env only.

enum QboEnvironment {
  SANDBOX
  PRODUCTION
}

// OAuth 2.0 connection to a QuickBooks company (realm). Tokens are AES-256-GCM
// encrypted at rest (key from env). One connection per realm per environment.
model QboConnection {
  id                    String         @id @default(cuid())
  realmId               String
  environment           QboEnvironment
  accessTokenEnc        String
  refreshTokenEnc       String
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime
  connectedById         String
  isActive              Boolean        @default(true)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@unique([realmId, environment])
  @@index([environment])
}

// CPQ entity <-> QuickBooks object id map (Customer, Item). Scoped by
// environment so sandbox ids never collide with production ids. The unique
// constraints are the duplicate-prevention backbone for find-or-create.
model QboEntityLink {
  id             String         @id @default(cuid())
  environment    QboEnvironment
  entity         String
  entityId       String
  qboId          String
  qboSyncToken   String?
  lastSyncedHash String?
  lastSyncedAt   DateTime?
  state          SyncState      @default(LINKED)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([environment, entity, entityId])
  @@unique([environment, entity, qboId])
  @@index([entity, entityId])
}

enum QboTxnType {
  ESTIMATE
  /// Full-value itemized invoice: the whole accepted order on one document,
  /// with the payment split expressed as terms. This is how SSG bills.
  INVOICE
  /// Portion invoices — retained for staged billing, unused by default.
  DEPOSIT_INVOICE
  PROGRESS_INVOICE
  FINAL_INVOICE
}

// State machine: DRAFT (prepared, totals frozen) -> PENDING_AUTHORIZATION ->
// AUTHORIZED (explicit user sign-off) -> CREATED (exists in QBO). FAILED is
// retryable (same idempotency key). VOIDED for manual reversal records.
enum QboTxnStatus {
  DRAFT
  PENDING_AUTHORIZATION
  AUTHORIZED
  CREATED
  FAILED
  VOIDED
}

// One row per intended financial transaction. The idempotencyKey is unique and
// is also passed to QuickBooks as the request id, so a retry NEVER creates a
// second document in either system. totalsSnapshot freezes the accepted
// proposal totals so they can never be silently altered.
model QboTransaction {
  id                String         @id @default(cuid())
  type              QboTxnType
  environment       QboEnvironment
  status            QboTxnStatus   @default(DRAFT)

  proposalId        String
  proposalVersionId String
  proposalVersion   Int

  // Frozen copy of the accepted proposal totals (never floats — minor units).
  currency          String
  proposalTotalMinor BigInt
  amountMinor       BigInt
  totalsSnapshot    Json

  idempotencyKey    String         @unique
  customerQboId     String?
  qboId             String?
  qboDocNumber      String?
  qboSyncToken      String?

  initiatedById     String
  authorizedById    String?
  authorizedAt      DateTime?
  error             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([proposalId, proposalVersion])
  @@index([status])
  @@index([type])
  @@index([environment])
}

// ---------------- Accepted Order & Operational Handoff ----------------
// When a proposal version is ACCEPTED it is locked into an immutable operational
// order. The order references the EXACT accepted version + price snapshot and
// carries a frozen content snapshot, so later proposal edits (only possible via
// a new version) can never silently alter what was sold. Everything downstream
// (procurement, production, shipping, install, training, tasks) hangs off it.

enum HandoffStatus {
  NEW
  IN_PROGRESS
  BLOCKED
  READY
  COMPLETE
  CANCELLED
}

enum CustomerApprovalMethod {
  SIGNATURE
  COUNTERSIGNED_PROPOSAL
  PURCHASE_ORDER
  EMAIL
  VERBAL
  PORTAL
}

enum RequirementCategory {
  PRODUCTION
  CUSTOM_PRODUCT
  SHIPPING
  INSTALLATION
  TRAINING
  CUSTOMER_RESPONSIBILITY
  FACILITY_ACCESS
  REQUIRED_DOCUMENT
}

enum RequirementStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  COMPLETE
  WAIVED
}

// Who the bill of materials ships to: the end customer's site, or Summit's dock.
enum BomShipTo {
  CUSTOMER
  SUMMIT
}

enum HandoffTaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

model AcceptedOrder {
  id                String        @id @default(cuid())
  number            String        @unique
  organizationId    String
  opportunityId     String?

  // Exact accepted proposal reference — the immutability anchor.
  proposalId        String
  proposalVersionId String        @unique
  acceptedVersion   Int
  priceSnapshotId   String
  ruleSnapshotId    String?

  currency          String
  grandTotalMinor   BigInt
  depositRequired   Boolean       @default(false)
  depositDueMinor   BigInt        @default(0)

  // Frozen copy of the accepted content + an integrity hash for drift detection.
  contentSnapshot   Json
  integrityHash     String

  status            HandoffStatus @default(NEW)
  locked            Boolean       @default(true)

  // ---- Bill of Materials header (operational, editable after lock) ----
  // The BOM is a shop/vendor document, so these are entered per order rather
  // than carried from the proposal.
  jobName           String?
  bomShipTo         BomShipTo     @default(CUSTOMER)
  bomSubmittedOn    DateTime?
  deliveryType      String?
  powderCoatBrand   String?
  shipmentQuote     String?
  bomNotes          String?

  // Integration cross-references (documented in QBO/monday milestones).
  qboEstimateTxnId  String?
  mondayProjectId   String?

  acceptedById      String
  acceptedAt        DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  customerApproval  CustomerApproval?
  requirements      HandoffRequirement[]
  procurement       ProcurementLine[]
  bomSections       BomVendorSection[]
  tasks             HandoffTask[]
  events            OrderEvent[]

  @@index([organizationId])
  @@index([status])
  @@index([proposalId])
}

// The customer's acceptance of record — who approved, how, and when.
model CustomerApproval {
  id             String                 @id @default(cuid())
  orderId        String                 @unique
  order          AcceptedOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method         CustomerApprovalMethod
  approverName   String
  approverTitle  String?
  approverEmail  String?
  poNumber       String?
  documentRef    String?
  ipAddress      String?
  approvedAt     DateTime
  notes          String?
  recordedById   String
  createdAt      DateTime               @default(now())
}

// Line-itemized procurement list, referencing the frozen accepted products.
model ProcurementLine {
  id           String        @id @default(cuid())
  orderId      String
  order        AcceptedOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  sku          String?
  name         String
  quantity     Int
  vendor       String?
  poNumber     String?
  sourced      Boolean       @default(false)
  // Snapshot of what we pay the vendor and what the part weighs, resolved from
  // the catalog at lock time (and backfilled once for orders locked earlier).
  unitCostMinor   Int?
  unitWeightLbs   Decimal?   @db.Decimal(10, 3)
  // Fabrication instructions that print on the BOM line.
  powderColor  String?
  /// Brand from the managed list, and the code as typed for THIS part. The printed
  /// `powderColor` above is kept in step ("Cardinal 5019") so a historic BOM still
  /// reads the same even if the brand is later renamed.
  powderBrandId   String?
  powderBrand     PowderColorBrand? @relation(fields: [powderBrandId], references: [id])
  powderColorCode String?
  /// Produced by expanding a kit (H-1000) into its fasteners. The proposal keeps the
  /// single kit line because that is what the customer buys; the shop needs the
  /// pieces, so the BOM lists them in their own trailing section.
  isHardwareComponent Boolean @default(false)
  kitSku          String?
  vendorNotes  String?
  targetDate   DateTime?
  notes        String?
  isException  Boolean       @default(false)
  exceptionReason String?

  @@index([orderId])
}

// Operational requirements by category (production, shipping, install, etc.).
model HandoffRequirement {
  id              String              @id @default(cuid())
  orderId         String
  order           AcceptedOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  category        RequirementCategory
  title           String
  detail          Json?
  status          RequirementStatus   @default(OPEN)
  targetDate      DateTime?
  isException     Boolean             @default(false)
  exceptionReason String?
  createdById     String
  /// Who last changed this requirement, shown beside the status so the order page
  /// reads as a history rather than an anonymous state.
  updatedById     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([orderId])
  @@index([category])
  @@index([status])
}

// Internal task assignment with owner + target date.
model HandoffTask {
  id              String            @id @default(cuid())
  orderId         String
  order           AcceptedOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  category        RequirementCategory?
  assigneeId      String?
  assigneeRole    Role?
  dueDate         DateTime?
  status          HandoffTaskStatus @default(TODO)
  isException     Boolean           @default(false)
  exceptionReason String?
  createdById     String
  /// Who last changed this task — shown beside the status on the order page.
  updatedById     String?
  completedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([orderId])
  @@index([assigneeId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Bill of Materials — per-vendor sections
//
// The BOM header used to be one record on the order, which meant every vendor
// shared one submission date, one set of notes and one lock. A section is that
// header scoped to a single vendor: its own dates, its own questions, its own
// send history, and its own confirm/unlock state. The order-level header fields
// on AcceptedOrder remain as the DEFAULTS a new section inherits.
// ---------------------------------------------------------------------------

enum BomSectionStatus {
  DRAFT
  SUBMITTED
}

model BomVendorSection {
  id              String           @id @default(cuid())
  orderId         String
  order           AcceptedOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Vendor name, matching ProcurementLine.vendor. 'Unassigned vendor' is a real
  /// section so unsourced parts still get a sheet.
  vendor          String
  /// Print/export order of the sections, and the order they appear on screen.
  sortOrder       Int              @default(0)

  jobName         String?
  shipTo          BomShipTo        @default(CUSTOMER)
  /// Null means "not submitted yet" — the UI shows today's date as the default.
  submittedOn     DateTime?
  deliveryType    String?
  powderCoatBrand String?
  shipmentQuote   String?
  notes           String?

  /// SUBMITTED freezes the section's fields; unlocking is an explicit action and
  /// is recorded on the order timeline.
  status          BomSectionStatus @default(DRAFT)
  /// The powder-colour column was printed on every vendor's sheet, where it was
  /// usually a column of dashes. Opt-in per section; seeded from the vendor default.
  showPowderColor Boolean          @default(false)
  /// Whether this vendor's sheet prints the packaging-bag column. Opt-in, the
  /// same way the powder-colour column is.
  showPackagingBag Boolean         @default(false)
  confirmedAt     DateTime?
  confirmedById   String?
  unlockedAt      DateTime?
  unlockedById    String?

  answers         BomVendorAnswer[]
  sends           BomSend[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([orderId, vendor])
  @@index([orderId])
}

enum BomQuestionType {
  TEXT
  LONG_TEXT
  NUMBER
  DATE
  SELECT
  MULTI_SELECT
  BOOLEAN
}

/// A reusable question definition, administered per vendor. Every new section for
/// that vendor starts with a copy of these, so "what gauge?" is asked of the same
/// fabricator on every order without re-typing it.
model BomQuestionTemplate {
  id        String          @id @default(cuid())
  /// Null applies the question to EVERY vendor section.
  vendor    String?
  label     String
  type      BomQuestionType @default(TEXT)
  /// Choice list for SELECT / MULTI_SELECT, as an ordered array of strings.
  options   Json?
  helpText  String?
  required  Boolean         @default(false)
  sortOrder Int             @default(0)
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([vendor])
}

/// The question AND its answer on one order's section. The label/type/options are
/// snapshotted so editing a template never rewrites history on a sent BOM.
model BomVendorAnswer {
  id         String           @id @default(cuid())
  sectionId  String
  section    BomVendorSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  templateId String?
  label      String
  type       BomQuestionType  @default(TEXT)
  options    Json?
  required   Boolean          @default(false)
  /// Scalar answers as text; MULTI_SELECT as a JSON array of strings.
  value      String?
  sortOrder  Int              @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([sectionId])
}

enum BomSendFormat {
  EXCEL
  PDF
  BOTH
}

enum BomSendStatus {
  QUEUED
  SENT
  FAILED
  DELIVERED
  BOUNCED
}

/// Audit trail for every BOM emailed to a vendor: who sent it, to whom, when, in
/// what format, and what the provider said afterwards. Append-only.
model BomSend {
  id                String           @id @default(cuid())
  sectionId         String
  section           BomVendorSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  orderId           String
  vendor            String
  toEmail           String
  ccEmails          String?
  subject           String
  bodyPreview       String?
  format            BomSendFormat    @default(PDF)
  status            BomSendStatus    @default(QUEUED)
  /// Resend's message id, so a delivery webhook can find this row later.
  providerMessageId String?
  error             String?
  sentById          String
  sentAt            DateTime         @default(now())
  deliveredAt       DateTime?
  openedAt          DateTime?

  @@index([sectionId])
  @@index([orderId])
  @@index([providerMessageId])
}

// ---------------------------------------------------------------------------
// Powder coat colours
//
// A customer picks a BRAND ("Cardinal", "Prismatic") and then types the specific
// colour CODE for each part — different parts of the same frame routinely carry
// different codes. The brand is a managed list because that is where the spelling
// drift was; the code is free text because the brands' catalogues change faster
// than we could maintain a copy of them.
// ---------------------------------------------------------------------------

model PowderColorBrand {
  id        String            @id @default(cuid())
  name      String            @unique
  website   String?
  active    Boolean           @default(true)
  sortOrder Int               @default(0)
  lines     ProcurementLine[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

// ---------------------------------------------------------------------------
// Ryan Capital financing options
//
// Payments are quoted from a PAYMENT FACTOR per term, not an interest rate:
// monthly payment = financed amount x factor. Factors are what the lessor
// publishes, so they are the editable unit.
// ---------------------------------------------------------------------------

model FinanceFactor {
  id          String   @id @default(cuid())
  termMonths  Int      @unique
  /// Payment per $1 financed, e.g. 0.032700 for 36 months.
  factor      Decimal  @db.Decimal(10, 6)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Append-only, order-scoped audit timeline (complements the global AuditLog).
model OrderEvent {
  id        String        @id @default(cuid())
  orderId   String
  order     AcceptedOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  action    String
  actorId   String
  detail    Json?
  createdAt DateTime      @default(now())

  @@index([orderId])
}

/// A freight RFQ is frozen the moment it is emailed. Correcting one means a new
/// revision, so the vendor and we can always point at the same document.
enum FreightRfqStatus {
  DRAFT
  SENT
  SUPERSEDED
}

enum FreightRfqSendStatus {
  QUEUED
  SENT
  FAILED
}

/// A request for freight costs, one per vendor per proposal — the same
/// segmentation the Bill of Materials uses, for the same reason: each vendor
/// quotes only what they ship.
model FreightRfq {
  id             String            @id @default(cuid())
  proposalId     String
  proposal       Proposal          @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  /// The proposal version the lines were taken from. Kept so a stale RFQ can be
  /// recognised after the proposal moves on.
  versionId      String
  organizationId String
  /// Vendor name as it appears on Sku.manufacturer, so lines can be grouped
  /// without a join through the product tree.
  vendor         String
  manufacturerId String?
  manufacturer   Manufacturer?     @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)

  /// "8050" — the monday Project ID, resolved once at creation. Stored rather
  /// than looked up on render: the reference on a sent document must never
  /// change, even if the board does.
  projectId      String
  /// "RFQ-8050", then "RFQ-8050 R2" on the first revision.
  reference      String
  revision       Int               @default(1)

  notes          String?
  status         FreightRfqStatus  @default(DRAFT)

  /// Ship-to, frozen at creation from the proposal's shipping address (billing
  /// when there is no shipping one) and the rep who built the proposal.
  shipToName     String
  shipToLine1    String?
  shipToLine2    String?
  shipToCity     String?
  shipToRegion   String?
  shipToPostal   String?
  shipToCountry  String?
  contactName    String?
  contactPhone   String?

  totalCostMinor Int               @default(0)
  sentAt         DateTime?
  sentById       String?
  createdById    String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  lines          FreightRfqLine[]
  sends          FreightRfqSend[]

  @@unique([proposalId, vendor, revision])
  @@index([versionId])
  @@index([organizationId])
  @@index([status])
}

/// One product line on the RFQ. Included by default; a rep unticks what should
/// not travel on this shipment. Unticked lines are kept rather than deleted so a
/// revision can put them back.
model FreightRfqLine {
  id                String     @id @default(cuid())
  rfqId             String
  rfq               FreightRfq @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  sku               String
  name              String
  quantity          Int        @default(1)
  /// What we pay the vendor for one unit, not what the customer pays us.
  unitCostMinor     Int        @default(0)
  extendedCostMinor Int        @default(0)
  included          Boolean    @default(true)
  /// True when a rep added this line by hand rather than it coming off the
  /// proposal for this vendor.
  addedManually     Boolean    @default(false)
  sortOrder         Int        @default(0)

  @@index([rfqId])
}

model FreightRfqSend {
  id                String               @id @default(cuid())
  rfqId             String
  rfq               FreightRfq           @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  toEmail           String
  ccEmails          String?
  subject           String
  bodyPreview       String
  status            FreightRfqSendStatus @default(QUEUED)
  providerMessageId String?
  error             String?
  sentById          String
  createdAt         DateTime             @default(now())

  @@index([rfqId])
}
