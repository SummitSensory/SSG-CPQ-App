#!/usr/bin/env sh

# Stop a push that would not compile.
#
# Two things reached main in one afternoon that this catches: four type errors
# from a Prisma client that had not been regenerated, and a deleted route file
# that app.ts still imported. Both are tsc errors, and neither was visible in a
# diff.
#
# No format check here. Prettier has never been run across this repo, so it
# reports 75 pre-existing files and would block every push. Formatting is
# handled per-commit by lint-staged instead, on changed files only.
#
# No db:migrate:status either — it reaches out to Neon, and a push should not
# fail because a laptop is offline. Same reason the integration suite is not here:
# those tests need the database. The UNIT suite is, as of 2026-08-28 — two tests
# guarding against billing a customer twice had been failing for weeks, in main,
# because nothing ran them. Three seconds a push is cheap insurance against a red
# suite becoming normal.
#
# Tools run through node rather than pnpm, so this works from a GUI client too:
# see .husky/pm.sh.
#
# To push anyway in an emergency: git push --no-verify

. "$(dirname "$0")/pm.sh"

# Unlike pre-commit, this one REFUSES rather than skipping. A missing formatter
# costs tidiness; an unchecked push is what put type errors in main.
if [ -z "$NODE_BIN" ]; then
  echo ""
  echo "pre-push: could not find node, so nothing was checked. Push refused."
  echo ""
  echo "  Push from a terminal in the repo instead:  git push"
  echo "  See .husky/pm.sh for the directories that were tried."
  echo ""
  exit 1
fi

echo "pre-push: typecheck"
run_tool typescript/bin/tsc --noEmit || exit 1

echo "pre-push: lint"
run_tool eslint/bin/eslint.js src api tests public || exit 1

echo "pre-push: unit tests"
run_tool vitest/vitest.mjs run tests/unit || exit 1