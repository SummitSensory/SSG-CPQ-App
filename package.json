{
  "name": "development-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "dev:ci": "tsx src/server.ts",
    "build": "tsc --noCheck -p tsconfig.build.json",
    "stamp": "node scripts/build-stamp.mjs",
    "start": "node dist/server.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "typecheck:only": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:count": "eslint public",
    "lint:strict": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm db:drift && pnpm db:migrate:status && pnpm db:check:integrity",
    "db:generate": "prisma generate",
    "db:new": "node scripts/new-migration.mjs",
    "db:drift": "node scripts/schema-drift-check.mjs",
    "db:migrate": "node -e \"console.error('\\nprisma migrate dev cannot run in this repo - the shadow database fails replaying 0001_init.\\nUse: pnpm db:new <name>   (see docs/database-migrations.md)\\n'); process.exit(1)\"",
    "db:migrate:deploy": "node scripts/migrate-deploy.mjs",
    "db:migrate:status": "prisma migrate status",
    "db:baseline": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script > baseline.sql",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:seed:catalog": "tsx --env-file=.env prisma/seed-catalog.ts",
    "db:seed:soar": "tsx --env-file=.env prisma/seed-soar.ts",
    "db:reset:password": "tsx --env-file=.env prisma/reset-user-password.ts",
    "db:backfill:snapshots": "tsx --env-file=.env prisma/backfill-price-snapshots.ts",
    "db:backfill:weights": "tsx --env-file=.env prisma/backfill-missing-weights.ts",
    "db:bags": "tsx --env-file=.env prisma/set-packaging-bags.ts",
    "db:report:shared-parts": "tsx --env-file=.env prisma/report-shared-parts.ts",
    "db:check:integrity": "tsx --env-file=.env prisma/check-part-integrity.ts",
    "db:check:integrity:strict": "tsx --env-file=.env prisma/check-part-integrity.ts --strict",
    "db:repair:half-parts": "tsx --env-file=.env prisma/repair-half-created-parts.ts",
    "db:align:vendors": "tsx --env-file=.env prisma/align-vendor-sourcing.ts",
    "db:report:catalog": "tsx --env-file=.env prisma/report-catalog-integrity.ts",
    "db:price:p2513": "tsx --env-file=.env prisma/price-p2513.ts",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test": "vitest run tests/unit tests/integration",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@fastify/helmet": "^12.0.1",
    "@prisma/client": "^6.19.3",
    "@sparticuz/chromium-min": "149.0.0",
    "argon2": "^0.41.1",
    "fastify": "^5.1.0",
    "jose": "^5.9.6",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "playwright-core": "^1.62.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/node": "^22.9.0",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.5.2",
    "prettier": "^3.3.3",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
